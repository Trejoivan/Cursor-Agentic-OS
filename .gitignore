# agentic-os .gitignore
#
# This repo contains multiple OS folders. User-generated artifacts should be
# private-by-default across ALL OSes (keep templates/docs/workflows tracked).

# ---- work-os (private user data) ----
work-os/Active/
work-os/Projects/
work-os/Career/
work-os/Knowledge/
work-os/Archive/
work-os/Deliverables/
work-os/Clients/

# Keep optional directory scaffolding if present
!work-os/Active/.gitkeep
!work-os/Projects/.gitkeep
!work-os/Career/.gitkeep
!work-os/Knowledge/.gitkeep
!work-os/Archive/.gitkeep

# ---- career-os (private user data) ----
career-os/Impact-Library/
career-os/Stories/
career-os/Applications/
career-os/Learnings/
career-os/Resumes/

# Resume review/modifier workspace (private by default; keep scaffold tracked)
career-os/Resume-Review/**
!career-os/Resume-Review/
!career-os/Resume-Review/**/
!career-os/Resume-Review/README.md
!career-os/Resume-Review/**/README.md
!career-os/Resume-Review/templates/
!career-os/Resume-Review/templates/**/
!career-os/Resume-Review/templates/**/*.md

# ---- personal-os (private user data) ----
personal-os/INBOX.md
personal-os/Tasks/
personal-os/Knowledge/
personal-os/Projects/
personal-os/Archive/

# ---- meeting-os (private user data) ----
meeting-os/Meetings/
meeting-os/Decisions/
meeting-os/Actions/
meeting-os/People/

# Ignore personal goals and backlog
GOALS.md
BACKLOG.md
INBOX.md

# But keep templates
!GOALS-template.md
!BACKLOG-template.md
!INBOX-template.md

# Ignore customized AGENTS.md (after setup)
# Uncomment this after you've customized it:
# AGENTS.md

# Health reports (generated, point-in-time)
.health/

# Repo-wide ad-hoc task ledger (local-first / private)
.task-ledger/

# Repo-local caches (private / reproducible)
.cache/

# ---- apps (private / local experiments) ----
apps/wedding-planner/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup

# Secrets / local env (never commit)
.env
.env.*
!.env.example

# Common private key / cert formats
*.pem
*.key
*.p12
*.pfx

# Common credential filenames
credentials.json
serviceAccount*.json

# BMAD consolidated project workspaces
# (junctions to the shared BMAD install/skills; generated by scripts/bmad-project.ps1)
bmad-projects/**/_bmad/
bmad-projects/**/.agents/

# BMAD skill-local knowledge packs (keep repo clean)
_Bmad/.agents/skills/**/resources/knowledge/
_Bmad/.agents/skills/**/knowledge/

# Private project idea workspaces (do not commit raw ideas)
# - BMAD major projects live under bmad-projects/<slug>/
# - mini-bmad ad-hoc runs live under _mini_bmad/runs/<yyyy-mm>/<yyyy-mm-dd>-<slug>/
# Publish/share only by copying curated artifacts into Published/
bmad-projects/*/
!bmad-projects/README.md
!bmad-projects/AGENTS.md

_mini_bmad/runs/

# mini-bmad BMAD-prep landing zone (private by default; keep scaffold tracked)
_mini_bmad/bmad_prep/**
!_mini_bmad/bmad_prep/
!_mini_bmad/bmad_prep/README.md
!_mini_bmad/bmad_prep/pending/
!_mini_bmad/bmad_prep/pending/README.md
!_mini_bmad/bmad_prep/done_prep_bmad/
!_mini_bmad/bmad_prep/done_prep_bmad/README.md

# ---- AD_HOC (private by default; keep scaffold tracked) ----
AD_HOC/**
!AD_HOC/
!AD_HOC/README.md
!AD_HOC/Meetings/
!AD_HOC/Meetings/README.md
!AD_HOC/workspace/
!AD_HOC/workspace/**/
!AD_HOC/workspace/README.md
!AD_HOC/workspace/**/README.md
