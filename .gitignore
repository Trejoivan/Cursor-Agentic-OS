# work-os .gitignore

# Ignore all actual work content (keep work private)
Active/
Projects/
Career/
Knowledge/
Archive/
Deliverables/
Clients/

# But keep the directory structure
!Active/.gitkeep
!Projects/.gitkeep
!Career/.gitkeep
!Knowledge/.gitkeep
!Archive/.gitkeep

# Ignore personal goals and backlog
GOALS.md
BACKLOG.md

# But keep templates
!GOALS-template.md
!BACKLOG-template.md

# Ignore customized AGENTS.md (after setup)
# Uncomment this after you've customized it:
# AGENTS.md

# Health reports (generated, point-in-time)
.health/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Backup files
*.bak
*.backup

# Secrets / local env (never commit)
.env
.env.*
!.env.example

# Common private key / cert formats
*.pem
*.key
*.p12
*.pfx

# Common credential filenames
credentials.json
serviceAccount*.json

# BMAD consolidated project workspaces
# (junctions to the shared BMAD install/skills; generated by scripts/bmad-project.ps1)
bmad-projects/**/_bmad/
bmad-projects/**/.agents/
