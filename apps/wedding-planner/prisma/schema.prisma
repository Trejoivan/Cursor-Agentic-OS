generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  inProgress
  done
}

enum RsvpStatus {
  notInvited
  invited
  yes
  no
  maybe
}

model Task {
  id        String     @id @default(uuid()) @db.Uuid
  title     String
  notes     String?
  status    TaskStatus @default(todo)
  dueDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  category     String?
  status       String   @default("researching")
  website      String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  quoteCents   Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@map("vendors")
}

model BudgetItem {
  id         String   @id @default(uuid()) @db.Uuid
  category   String
  name       String
  targetCents Int?
  actualCents Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@map("budget_items")
}

model Guest {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  partySize  Int        @default(1)
  side       String?    // e.g. "Bride", "Groom", "Both"
  rsvpStatus RsvpStatus @default(invited)
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([rsvpStatus])
  @@index([side])
  @@map("guests")
}

